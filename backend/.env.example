PORT=3000
NODE_ENV=development

# Security
APP_API_KEY=change-me-local-api-key
WEBHOOK_SECRET=change-me-tradingview-secret

# Safety first
DRY_RUN=true
BOT_ENABLED=false
MAX_LEVERAGE=2
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=3
MAX_RISK_PER_TRADE_PCT=1
MAX_NOTIONAL_USDT=50

# Market universe
ALLOWED_SYMBOLS=EVAA_USDT,BTC_USDT,ETH_USDT
DEFAULT_TIMEFRAME=Min60

# MEXC API - keep these server-side only
MEXC_ACCESS_KEY=
MEXC_SECRET_KEY=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
